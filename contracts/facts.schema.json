{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "用药连续性事实流",
  "description": "区域医联体慢性肾病跨院用药连续性台账的事实记录格式。只追加；遗传信息与完整病历禁止进入。",
  "type": "object",
  "required": ["domain", "records"],
  "properties": {
    "domain": { "const": "renal-care-continuity" },
    "as_of": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "description": { "type": "string" },
    "drug_catalog": { "type": "object" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "isoDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "actor": {
      "type": "object",
      "required": ["id", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": {
          "enum": ["patient", "clinician", "hospital_operator", "regulator", "authorizer"]
        }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": ["type", "payload", "actor"],
      "properties": {
        "type": {
          "enum": [
            "patient_alias",
            "dialysis_schedule",
            "care_episode",
            "regimen_version",
            "prescription",
            "dispense",
            "prescription_void",
            "clinician_note",
            "patient_correction",
            "hospital_supplement",
            "shortage_substitution",
            "exception_grant",
            "temp_hold",
            "temp_hold_release",
            "review_decision"
          ]
        },
        "payload": { "type": "object" },
        "actor": { "$ref": "#/$defs/actor" },
        "occurred_at": { "$ref": "#/$defs/isoDate" }
      },
      "additionalProperties": false
    },
    "exception_grant_payload": {
      "type": "object",
      "required": ["patient_code", "grant_id", "reason", "valid_from", "valid_to"],
      "properties": {
        "patient_code": { "type": "string", "minLength": 1 },
        "grant_id": { "type": "string", "minLength": 1 },
        "reason": { "enum": ["transfer", "emergency", "shortage"] },
        "drug_codes": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "valid_from": { "$ref": "#/$defs/isoDate" },
        "valid_to": { "$ref": "#/$defs/isoDate" },
        "confirmed_by": { "type": "string", "minLength": 1 },
        "basis": { "type": "string" }
      },
      "additionalProperties": true
    },
    "review_decision_payload": {
      "type": "object",
      "required": ["patient_code", "review_id", "conflict_id", "decision", "decided_on"],
      "properties": {
        "decision": { "enum": ["upheld", "resolved", "escalate_investigation"] },
        "decided_on": { "$ref": "#/$defs/isoDate" }
      },
      "additionalProperties": true
    }
  }
}
